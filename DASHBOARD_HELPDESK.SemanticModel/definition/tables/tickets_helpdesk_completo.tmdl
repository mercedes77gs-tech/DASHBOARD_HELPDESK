	column Tiempo_ticket = IF(tickets_helpdesk_completo[Estado]="cerrado", [Fecha_Cierre]-[Fecha_Apertura],blank())
		dataType: dateTime
		formatString: hh"H"nn
		lineageTag: bb5fdd6f-eac1-4c3f-a573-7d348d034b61
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

