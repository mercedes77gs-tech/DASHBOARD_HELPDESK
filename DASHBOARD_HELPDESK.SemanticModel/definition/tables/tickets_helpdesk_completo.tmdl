		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	partition tickets_helpdesk_completo = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents("Z:\MIS TRABAJOS\DASHBOARD_HELPDESK\CSV\tickets_helpdesk_completo.csv"),[Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Encabezados promovidos" = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
