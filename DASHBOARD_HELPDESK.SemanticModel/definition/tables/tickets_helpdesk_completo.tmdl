table tickets_helpdesk_completo
	lineageTag: a13821cc-55cb-4de7-bf58-5108d7961081

	measure '% Tickets Resueltos' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(tickets_helpdesk_completo),
			        tickets_helpdesk_completo[Estado] = "Cerrado"
			    ),
			    COUNTROWS(tickets_helpdesk_completo),
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: fa316980-d3ab-4430-a933-5302b890f062

	measure Satisfaccion_Media = AVERAGE(tickets_helpdesk_completo[Satisfaccion])
		lineageTag: 4b51d061-9d17-4f95-ac59-c94dea581ca4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Backlog_Fijo = ```
			CALCULATE( COUNT(tickets_helpdesk_completo[ID_Ticket]), ALL(tickets_helpdesk_completo), tickets_helpdesk_completo[Estado] = "Abierto" )
			
			```
		formatString: 0
		lineageTag: d180288b-6ad4-41aa-9485-1b1c3cc29057

	measure 'PROMEDIO MIN RESOLUCION' = AVERAGEX(FILTER('tickets_helpdesk_completo','tickets_helpdesk_completo'[ESTADO]="Cerrado"),HOUR('TICKETS_HELPDESK_COMPLETO'[TIEMPO_TICKET])+60+MINUTE('TICKETS_HELPDESK_COMPLETO'[TIEMPO_TICKET]))
		formatString: 0
		lineageTag: 41b035ac-091e-4921-a01f-0e218a367ca6

	column ID_Ticket
		dataType: string
		lineageTag: 42f2e92d-5207-45b5-8573-f49e4f090523
