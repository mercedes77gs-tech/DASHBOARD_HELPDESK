table 'AGENTE - copia'
	lineageTag: 407be612-1f5c-4739-aeab-fe039c72eb29

	measure URL_Visor_Imagen = ```
			
			VAR IDActivo = SELECTEDVALUE(tickets_helpdesk_completo[ID_Agente])
			VAR TurnoActivo = SELECTEDVALUE('AGENTE - copia'[Departamento / Turno]) // Cambia [Turno] por el nombre exacto de tu columna
			
			RETURN
			SWITCH(
			    TRUE(),
			    -- 1. Si has clicado en un agente concreto, muestra su foto individual:
			    NOT ISBLANK(IDActivo), 
			        LOOKUPVALUE('AGENTE - copia'[URL_FOTO], 'AGENTE - copia'[ID_Agente], IDActivo),
			
			    -- 2. Si has clicado en una tarjeta de Turno, muestra la foto grupal de ese turno:
			    TurnoActivo = "Soporte Externo", "https://github.com/mercedes77gs-tech/IMAGENES_AGENTES_DASHBOARD_HELPDESK/blob/main/Soporte_externo.jpg?raw=true",
			    TurnoActivo = "Turno Tarde", "https://github.com/mercedes77gs-tech/IMAGENES_AGENTES_DASHBOARD_HELPDESK/blob/main/Turno_tarde.jpg?raw=true",
			    TurnoActivo = "Turno Mañana", "https://github.com/mercedes77gs-tech/IMAGENES_AGENTES_DASHBOARD_HELPDESK/blob/main/Turno_ma%C3%B1ana.jpg?raw=true",
			
			    -- 3. Si no hay nada seleccionado (por defecto), muestra el logo general:
			    "https://github.com/mercedes77gs-tech/IMAGENES_AGENTES_DASHBOARD_HELPDESK/blob/16ada3c8c87a58525a73dfe60709a5685b8986a9/GRUPO_HELPDESK.png?raw=true"
			)
			
			       
			    
			```
		lineageTag: 477e0c76-adfb-4cb8-abc4-c2a118e371f0

	measure Nombre_Visor_Dinamico = ```
			
			VAR IDActivo = SELECTEDVALUE(tickets_helpdesk_completo[ID_Agente])
			VAR TurnoActivo = SELECTEDVALUE('AGENTE - copia'[Departamento / Turno]) -- Cambia [Turno] por el nombre exacto de tu columna
			
			RETURN
			SWITCH(
			    TRUE(),
			    -- 1. Si hay un agente concreto seleccionado, muestra su nombre:
			    NOT ISBLANK(IDActivo), 
			        LOOKUPVALUE('AGENTE - copia'[Nombre_Agente], 'AGENTE - copia'[ID_Agente], IDActivo),
			
			    -- 2. Si no hay agente, pero hay un turno seleccionado, muestra el nombre del turno:
			    NOT ISBLANK(TurnoActivo), 
			        TurnoActivo,
			
			    -- 3. Si no hay nada seleccionado, muestra el texto por defecto:
			    "Equipo Helpdesk"
			)
			```
		lineageTag: 5a2044c2-5137-46c1-b84c-d0dab5110a85

